{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jeju_Cardmaker skill plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "series_title",
    "head_copy",
    "slides"
  ],
  "properties": {
    "series_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "head_copy": {
      "type": "string",
      "maxLength": 300
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "title"
        ],
        "properties": {
          "role": {
            "enum": [
              "cover",
              "body",
              "closing"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "bullets": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "footnote": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        }
      }
    }
  },
  "$comment": "Role order is checked by validate_plan. Structural validation is not factual validation."
}
